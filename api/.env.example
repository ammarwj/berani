PORT=8080
DATABASE_URL=postgres://berani:berani@localhost:5432/berani?sslmode=disable
JWT_SECRET=change-me

# Satu-satunya nilai Access-Control-Allow-Origin, sekaligus basis tautan di email
# verifikasi & reset password. Harus persis asal yang dibuka browser, termasuk
# skema dan port — satu nilai saja, jadi www. tidak akan lolos CORS.
APP_BASE_URL=http://localhost:3000

# AES-256-GCM key for reflection journals (PRD §8.2). REQUIRED — the server
# refuses to start without it. Generate with: openssl rand -hex 32
#
# TIDAK BISA DIBUAT ULANG. Jurnal yang sudah terenkripsi hanya terbaca dengan kunci
# yang sama; menggantinya membuat semuanya permanen tidak terbaca. Di server, backup
# api/.env offline bersama dump DB — dump tanpa kunci ini tidak ada gunanya.
REFLECTION_KEY=

# Cloudflare R2 for report attachments. Leave blank to run without uploads —
# the API starts and disables the attachment endpoint.
# Isi R2_ENDPOINT (disalin apa adanya dari dashboard R2) ATAU R2_ACCOUNT_ID.
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# SMTP for verification and password-reset email. Leave blank in dev — messages
# are written to the log instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
