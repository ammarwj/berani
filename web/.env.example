# Untuk `bun dev` / `bun run build` di luar Docker. Salin ke web/.env.local.
#
# PENTING: NEXT_PUBLIC_* di-INLINE ke bundle saat build, bukan dibaca saat runtime.
# Di Docker nilainya datang dari build arg (lihat web/Dockerfile dan build.args di
# docker-compose.yml) — file ini tidak ikut ke dalam image. Mengubah `environment:`
# di compose tidak akan mengubah bundle; harus build ulang dengan arg yang benar.

# Asal API. Harus cocok dengan APP_BASE_URL di sisi Go, kalau tidak CORS memblokir
# semua request.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Nama cache service worker (public/sw.js) dan penanda versi registrasinya. Di
# produksi deploy/deploy.sh mengisinya dengan short SHA commit; nilai tetap berarti
# HTML basi disajikan selamanya setelah deploy.
NEXT_PUBLIC_BUILD_ID=dev
